+TEST_CASE("direct chaining: チェーン 2 本目以降の G10 は積んだサイクルを捨てない")
+{
+    // **1 本目が走った後で 2 本目が 1 命令も進まなかった場合。**
+    //
+    // ここで kDeferToStep を返すと、契約 (「kDeferToStep なら状態を 1 ビットも
+    // 変えていない」) を破る — 1 本目は状態を進めている。**時間が消えて
+    // デバイスが遅れる**形で壊れ、症状は原因から遠い。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    cb.place(kA, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kB, true);
+    cb.place(kB, FakeBlock{0, 0, false, false, 0, true, 0, false, 0});
+
+    const x68k::NativeResult r = h.runAt(kA, 0xFFFFFFFFu);
+
+    // **kRan で 1 本目のサイクルを返すこと。**
+    CHECK(r.exit == x68k::NativeExit::kRan);
+    CHECK(r.cycles == 8);
+    CHECK(sc.calls.size() == 2);
+    // 1 本も進まなかった扱い (deferGuard) にはしない。
+    CHECK(h.stats().deferGuard == 0);
+    CHECK(h.stats().chainStopIncomplete == 1);
+}
