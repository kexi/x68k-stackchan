+// --- D6: miss で break (チェーンの中で翻訳しない) -----------------------------
+
+TEST_CASE("direct chaining: 飛び先が未翻訳ならチェーンの中で翻訳しない")
+{
+    // **変異: ループ内で translate を呼ぶ** → translated / translateFail が
+    // 動く。
+    //
+    // 翻訳・負のキャッシュ・満杯からの回復は「何本目か」と無関係に成り立つ
+    // べき経路で、ループへ入れるとチェーン長がそれらの統計を歪める
+    // (満杯の閾値が 1 呼び出しで何度も進む等)。段 0-I の admission が
+    // 「機構が測定どおりに動かない」形で撤回になった直後なので、
+    // **測る対象を動かす変更は明示的に排除する。**
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    // A は B へ飛ぶが、B のスロットは置かない (= 未翻訳)。
+    // **B の番地には翻訳できる命令列がある** (Harness が MOVEQ を敷いて
+    // いる) ので、翻訳を呼べば成功してしまう = 呼んでいないことが問える。
+    cb.place(kA, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kB, true);
+
+    const std::uint64_t translatedBefore = h.stats().translated;
+    const x68k::NativeResult r = h.runAt(kA, 0xFFFFFFFFu);
+
+    CHECK(r.exit == x68k::NativeExit::kRan);
+    CHECK(sc.calls.size() == 1);
+    // **1 度も翻訳していないこと。**
+    CHECK(h.stats().translated == translatedBefore);
+    CHECK(h.stats().translateFail == 0);
+    CHECK(h.stats().negativeHit == 0);
+    CHECK(h.stats().fullDeferred == 0);
+    // 鍵外れの帰属も動かないこと (2 本目以降の miss は現行経路の統計を
+    // 触らずに break する)。
+    CHECK(h.stats().keyMissCold == 0);
+    CHECK(h.stats().chainStopMiss == 1);
+    // 呼び出し側は次の run() で kB から普通に始められる。
+    CHECK(h.cpu().state().pc == kB + 4);
+}
