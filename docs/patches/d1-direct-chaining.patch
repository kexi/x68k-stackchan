+// --- D8: 勘定の保存 -----------------------------------------------------------
+
+TEST_CASE("direct chaining: チェーンの切れ方の内訳が runCalls と一致する")
+{
+    // **T1 と同じ問い方。** 和が合わなければ、どのカウンタにも乗らない
+    // break がある。fullDeferred が無かったせいで実機 45 秒の主因を
+    // 見落とした前例と同じ形なので、収支を縛る。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+    constexpr u32 kC = 0x3000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    cb.place(kA, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kB, true);
+    cb.place(kB, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kC, true);
+    cb.place(kC, FakeBlock{8, 0x4000, false, false, 0, false, 0, false, 0});
+
+    // miss / budget / defer / incomplete を全部踏ませる。
+    h.runAt(kA, 0xFFFFFFFFu);  // miss (kC の先が空き)
+    h.runAt(kA, 8);            // budget
+    h.cpu().requestInterrupt(6, 0x40);
+    h.runAt(kA, 0xFFFFFFFFu);  // 入口 defer
+
+    const x68k::NativeStats& s = h.stats();
+    const std::uint64_t sum =
+        s.chainStopMiss + s.chainStopIncomplete + s.chainStopDefer + s.chainStopBudget;
+    INFO("runCalls=", s.runCalls, " miss=", s.chainStopMiss, " incomplete=", s.chainStopIncomplete,
+         " defer=", s.chainStopDefer, " budget=", s.chainStopBudget);
+    CHECK(s.runCalls == 3);
+    CHECK(sum == s.runCalls);
+}
