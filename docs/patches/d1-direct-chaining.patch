+    CHECK(r.exit == x68k::NativeExit::kRan);
+    CHECK(sc.calls.size() == 2);
+    CHECK(r.cycles == 16);
+    CHECK(h.stats().dynamicBranch == 1);
+    CHECK(h.cpu().state().pc == 0x3000 + 4);
+}
