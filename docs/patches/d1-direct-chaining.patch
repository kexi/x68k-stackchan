+// --- D9: 回帰 — pull 型は依然として守られている --------------------------------
+
+TEST_CASE("direct chaining: ページ書き込み後は旧ブロックが決して実行されない")
+{
+    // **明示的な回帰。** これは D-1 以前から成り立っていた性質だが、
+    // チェーンを入れた今こそ落ちうる (毎 hop の照合を省く変異が入りうる)。
+    //
+    // code_gen_map.h が push 型を棄却した根拠そのもの: 「消し忘れた
+    // ブロックを実行する」状態が原理的に存在しない。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    cb.place(kA, FakeBlock{8, 0x2000, false, false, 0, false, 0, false, 0});
+
+    // 置いた直後は当たる。
+    h.runAt(kA, 0);
+    REQUIRE(sc.calls.size() == 1);
+
+    // 再翻訳を封じる。**窓は触らない** (setFastRamReadable は
+    // bumpMappingEpoch を呼ぶので、鍵が世代ではなく epoch で外れてしまい、
+    // 問いたい「世代で外れる」が測れなくなる)。命令語を奇数番地にしても
+    // 同じ理由で鍵の外れ方が変わるので、**負のキャッシュへ「世代不問」を
+    // 焼いて**再翻訳だけを止める。
+    h.runner.setNegativeStorage(h.negEntries.data(),
+                                static_cast<std::uint32_t>(h.negEntries.size()));
+
+    // **ゲストがそのページを書いた。**
+    h.cpu().codeGenMap().touch(kA + 0x20);
+
+    const x68k::NativeResult r = h.runAt(kA, 0);
+
+    // **1 本も走っていないこと。** 古いコードは二度と実行されない。
+    // (翻訳は成功しうるが、成功したら偽物ではない本物の Xtensa の機械語が
+    //  載るので runBlock の差し替えは呼ばれない = calls は増えない)
+    CHECK(sc.calls.size() == 1);
+    // **世代で外れたこと。** 他の理由で外れていたら、この回帰は
+    // 「たまたま走らなかった」を見ているだけになる。
+    CHECK(h.stats().keyMissGen == 1);
+    CHECK(h.stats().keyMissEpoch == 0);
+    CHECK(h.stats().keyMissTag == 0);
+    (void)r;
+}
