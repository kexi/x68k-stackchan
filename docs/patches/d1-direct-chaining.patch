+// --- D7: ガード脱出でチェーンが切れる -----------------------------------------
+
+TEST_CASE("direct chaining: ガード脱出したらチェーンは必ず切れる")
+{
+    // 半端に進んだブロックの続きは step() が本物の read/write で実行する。
+    // **その手前でチェーンを続けると、I/O の副作用や例外を飛ばしたまま
+    // 次のブロックへ進む。**
+    //
+    // 変異: chainStop の ranOk 検査を消す → 2 本目が走る。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    SUBCASE("途中まで進んだガード脱出")
+    {
+        // ranOps = 1 なので kRan で戻る。**チェーンは続けない。**
+        cb.place(kA, FakeBlock{4, 0, false, false, 0, true, 1, false, 0}, kB, true);
+        cb.place(kB, FakeBlock{8, 0x3000, false, false, 0, false, 0, false, 0});
+
+        const x68k::NativeResult r = h.runAt(kA, 0xFFFFFFFFu);
+        CHECK(r.exit == x68k::NativeExit::kRan);
+        CHECK(r.cycles == 4);
+        CHECK(sc.calls.size() == 1);
+        CHECK(h.stats().guardExit == 1);
+        CHECK(h.stats().chainStopIncomplete == 1);
+    }
+
+    SUBCASE("1 命令も進まなかったガード脱出 (G10)")
+    {
+        cb.place(kA, FakeBlock{0, 0, false, false, 0, true, 0, false, 0}, kB, true);
+
+        const x68k::NativeResult r = h.runAt(kA, 0xFFFFFFFFu);
+        CHECK(r.exit == x68k::NativeExit::kDeferToStep);
+        CHECK(r.cycles == 0);
+        CHECK(h.stats().deferGuard == 1);
+        CHECK(h.stats().chainStopIncomplete == 1);
+    }
+}
