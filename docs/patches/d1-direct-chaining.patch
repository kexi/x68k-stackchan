+// ============================================================================
+// 段 D-1: direct chaining (ランナー内ディスパッチループ)
+// ============================================================================
+//
+// ## ここで問うのは「ループが余計に走らないこと」
+//
+// チェーンが守っているものは全部**積極的すぎる側**に壊れる。
+//
+//   毎 hop の鍵照合を省く   → 書き換えられた番地の古いコードを実行する
+//   毎 hop の世代を持ち上げる → 同上。しかも**先行ブロック自身の書き込み**で起きる
+//   毎 hop の defer を省く   → 割り込みの受理がチェーン長ぶん遅れる
+//   budget を省く           → デバイスの期限を跨いだまま何本も走る
+//   ガード脱出で続ける       → 半端に進んだ状態の続きを JIT が実行する
+//   チェーンの中で翻訳する   → 満杯の閾値や負のキャッシュの統計が歪む
+//
+// **後ろ 2 つ以外は、実行後の状態を比べても 1 ビットも違わない。**
+// 割り込みは遅れて受理されるだけ、期限はずれて発火するだけで、
+// M68kState もメモリも「正しい」。MEMORY.md の
+// 「保守的なフォールバックはテストの盲点になる」の裏返しで、
+// **積極的すぎる側も、正しさのテストでは見えない。**
+//
+// なので問い方を変える。ここでは全部「何本走ったか」と「どこで切れたか」
+// を数え、期待した本数と切れ方に一致することを問う。
+//
+// ## runBlock をホストで走らせる
+//
+// 生成コードは Xtensa の機械語なのでホストでは呼べず、チェーンの 2 本目
+// 以降は**実物を走らせない限り 1 行も踏めない**。exec_memory.h の
+// setRunBlockHookForTest でホストのビルドだけ runBlock の中身を差し替え、
+// 「ブロックが走った」ことにして戻り値と副作用を偽物が作る。
+// **差し替え点は runBlock ただ 1 行**なので、その上のループ本体は実機と
+// 1 文字も変わらないものをテストが踏む。
+
+namespace runner_chain
+{
+
+using runner_accounting::Harness;
+
+// 偽のブロック 1 本ぶんの台本。**生成コードの出口の契約をそのまま真似る。**
+//
+//   - 素通り  : pc = fallThroughPc + 4 を自分で書く (生成コードがそうする)
+//   - 静的分岐: pc は書かない。runner が branchTo(BlockSlot::branchTarget) する
+//   - 動的分岐: メールボックスへ飛び先を書き、bit29 を立てる
+//
+// writeAddr が非 0 なら、走るついでにゲスト RAM を 1 バイト書いて世代を
+// touch する (Tier C の G14/G16 が生成コードの中でやること)。
+// **これがチェーンの自己無効化を作る唯一の道具。**
+struct FakeBlock
+{
+    u32 cycles = 8;
+    // 素通りのときに書き戻す pc (命令語 + 4 の形で渡す)。
+    u32 fallThroughPc = 0;
+    bool branchTaken = false;
+    bool dynamicBranch = false;
+    u32 dynamicTarget = 0;
+    bool guardExit = false;
+    std::uint8_t ranOps = 0;
+    bool selfPageExit = false;
+    // 走るついでにゲスト RAM を書く番地 (0 なら書かない)。
+    u32 writeAddr = 0;
+};
+
+// 差し替えた runBlock が読む台本。**code ポインタを鍵にする**ので、
+// スロットごとに違うブロックを演じられる。
+struct Script
+{
+    x68k::M68k* cpu = nullptr;
+    x68k::CodeGenMap* map = nullptr;
+    std::vector<u8>* ram = nullptr;
+    // 偽のブロックが飛び先を書く先 (BlockRunner::branchMailboxForTest)。
+    std::uint32_t* mailbox = nullptr;
+    std::map<const void*, FakeBlock> blocks;
+    // 実際に呼ばれた code ポインタの並び。**何本走ったかの一次資料。**
+    std::vector<const void*> calls;
+    // n 本目を走らせる直前に割り込みを立てる (0 なら立てない)。
+    int raiseIrqBefore = 0;
+};
+
+Script* g_script = nullptr;
+
+std::uint32_t fakeRunBlock(void* state, const void* code)
+{
+    REQUIRE(g_script != nullptr);
+    Script& sc = *g_script;
+    // **state は必ず本物の M68kState を指すこと。** 実物の runner は
+    // &cpu.state() を渡す。ここが違えば、ループが状態を取り違えている。
+    REQUIRE(state == static_cast<void*>(&sc.cpu->state()));
+
+    const auto it = sc.blocks.find(code);
+    REQUIRE(it != sc.blocks.end());
+    const FakeBlock& b = it->second;
+
+    sc.calls.push_back(code);
+
+    if (sc.raiseIrqBefore != 0 && static_cast<int>(sc.calls.size()) == sc.raiseIrqBefore)
+    {
+        // **走り終えた直後に割り込みが立つ形。** 実機では MFP が
+        // reachSlow で立てるが、ここでは「このブロックの実行中に立った」
+        // ことにする。次の hop の mustDeferToStep が見るべきもの。
+        sc.cpu->requestInterrupt(6, 0x40);
+    }
+
+    if (b.writeAddr != 0)
+    {
+        // 生成コードがゲスト RAM を書くときは、必ず世代も touch する
+        // (Tier C の G14/G16)。**片方だけ真似ると、テストが実機より
+        // 甘くなる**ので両方やる。
+        (*sc.ram)[b.writeAddr] = 0x4E;
+        sc.map->touch(b.writeAddr);
+    }
+
+    std::uint32_t ret = b.cycles & x68k::jit::kCycleMask;
+    if (b.guardExit)
+    {
+        ret |= x68k::jit::kGuardExitFlag;
+        ret |= (static_cast<std::uint32_t>(b.ranOps) & x68k::jit::kGuardCountMask)
+               << x68k::jit::kGuardCountShift;
+        if (b.selfPageExit)
+        {
+            ret |= x68k::jit::kSelfPageExitFlag;
+        }
+        // ガード脱出は途中で降りるので pc は書き換えない。
+        return ret;
+    }
+    if (b.branchTaken)
+    {
+        // 静的分岐。**pc は runner の branchTo が書く。**
+        return ret | x68k::jit::kBranchTakenFlag;
+    }
+    if (b.dynamicBranch)
+    {
+        // 動的分岐。飛び先はメールボックスへ (アドレスは翻訳時に焼かれる)。
+        REQUIRE(sc.mailbox != nullptr);
+        *sc.mailbox = b.dynamicTarget;
+        return ret | x68k::jit::kDynamicBranchFlag;
+    }
+    // 素通り。生成コードが pc を fallThroughPc + 4 へ書く。
+    sc.cpu->state().pc = b.fallThroughPc + 4;
+    return ret;
+}
+
+}  // namespace runner_chain
+
+namespace runner_chain
+{
+
+// runBlock の差し替えを 1 つのテストの間だけ有効にする。
+struct HookGuard
+{
+    explicit HookGuard(Script& sc)
+    {
+        g_script = &sc;
+        x68k::jit::setRunBlockHookForTest(&fakeRunBlock);
+    }
+    ~HookGuard()
+    {
+        x68k::jit::setRunBlockHookForTest(nullptr);
+        g_script = nullptr;
+    }
+    HookGuard(const HookGuard&) = delete;
+    HookGuard& operator=(const HookGuard&) = delete;
+};
+
+// チェーンを手で組み立てる台。
+//
+// **翻訳を通さない。** 翻訳はホストでも走るが、成功すると本物の Xtensa の
+// 機械語がスロットへ載る。ここで問いたいのは「走り切った後にループが
+// どう判断するか」なので、スロットの鍵だけを実物と同じ形で置き、
+// code には偽のブロックの目印を入れる。
+//
+// **鍵は実装と同じ 7 項が当たる値を入れる。** 1 項でも外れれば hit に
+// ならず、テストは「チェーンが伸びなかった」として落ちる — つまり
+// この台自体が鍵照合の存在を前提にしている。
+struct ChainBuilder
+{
+    Harness& h;
+    Script& sc;
+    // 偽ブロックの目印。中身は読まれない (差し替えた runBlock が鍵に使うだけ)。
+    std::vector<std::unique_ptr<std::uint8_t[]>> marks;
+
+    ChainBuilder(Harness& harness, Script& script) : h(harness), sc(script)
+    {
+        sc.cpu = &h.cpu();
+        sc.map = &h.cpu().codeGenMap();
+        sc.ram = &h.ram;
+        sc.mailbox = h.runner.branchMailboxForTest();
+    }
+
+    // entryPc に「当たる」スロットを 1 つ置く。
+    const void* place(u32 entryPc, const FakeBlock& block, u32 branchTarget = 0,
+                      bool endsWithBranch = false, bool endsWithDynamicBranch = false)
+    {
+        marks.push_back(std::make_unique<std::uint8_t[]>(4));
+        const std::uint8_t* mark = marks.back().get();
+
+        x68k::CodeGenMap& map = h.cpu().codeGenMap();
+        x68k::jit::BlockSlot& slot = h.slots[foldedIndexOf(entryPc)];
+        slot.entryPc = entryPc;
+        slot.mappingEpoch = map.mappingEpoch();
+        slot.page = entryPc >> x68k::CodeGenMap::kPageShift;
+        slot.pageGen = map.generation(entryPc);
+        slot.count = 1;
+        slot.code = mark;
+        slot.endsWithBranch = endsWithBranch;
+        slot.endsWithDynamicBranch = endsWithDynamicBranch;
+        slot.branchTarget = branchTarget;
+
+        sc.blocks[mark] = block;
+        return mark;
+    }
+
+    std::uint32_t foldedIndexOf(u32 pc) const
+    {
+        return runner_accounting::foldedIndex(pc, Harness::kSlots);
+    }
+};
+
+}  // namespace runner_chain
+
+// --- D1: チェーンは実際に伸びる ---------------------------------------------
+
+TEST_CASE("direct chaining: 静的分岐で繋がったブロックを続けて走る")
+{
+    // **これが土台。** 以下の全テストは「本来なら N 本走る」ことを前提に
+    // 「壊すと N 本走らなくなる」形で問う。まず N 本走ることを確かめる。
+    //
+    // 3 本鎖: A --BRA--> B --BRA--> C (C は素通りで終わり、その先は空きスロット)
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+    constexpr u32 kC = 0x3000;
+    constexpr u32 kEnd = 0x4000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    cb.place(kA, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kB, true);
+    cb.place(kB, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kC, true);
+    cb.place(kC, FakeBlock{8, kEnd, false, false, 0, false, 0, false, 0});
+    // kEnd のスロットは置かない = 4 本目の鍵が外れてチェーンが切れる。
+
+    const x68k::NativeResult r = h.runAt(kA);
+
+    CHECK(r.exit == x68k::NativeExit::kRan);
+    // **3 本ぶんのサイクルが合計で返ること。** 1 本ぶんしか返さないなら、
+    // Machine が時間を落とす (デバイスの時刻が遅れる)。
+    CHECK(r.cycles == 24);
+    REQUIRE(sc.calls.size() == 3);
+    CHECK(h.stats().blocksRun == 3);
+    CHECK(h.stats().runCalls == 1);
+    // 4 本目の鍵が外れて切れたこと。**翻訳は 1 度も呼ばれていない**
+    // (チェーンの中で翻訳しない)。
+    CHECK(h.stats().chainStopMiss == 1);
+    CHECK(h.stats().translated == 0);
+    CHECK(h.stats().translateFail == 0);
+    // 最後の pc が kEnd の入口を指していること (branchTo / 素通りの書き戻し)。
+    CHECK(h.cpu().state().pc == kEnd + 4);
+}
+
+// --- D2: 同値性 (チェーン実行と 1 ブロック実行がビット単位で一致) ------------
+
+TEST_CASE("direct chaining: チェーン実行は 1 本ずつ実行したのとビット単位で同じ")
+{
+    // **チェーンが状態を変えないことの主張。** 同じ 3 本鎖を
+    //   (a) budget を大きくして 1 呼び出しで 3 本
+    //   (b) budget を 0 にして 1 本ずつ 3 呼び出し
+    // で走らせ、M68kState・ゲスト RAM・世代配列を全部比べる。
+    //
+    // **変異: 世代の照合を hop で省く** → (a) は書き換え後のページの
+    // 古いブロックを走らせ、(b) は鍵が外れて走らせない。差が出る。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+    constexpr u32 kC = 0x3000;
+    constexpr u32 kEnd = 0x4000;
+    // 走るついでにゲスト RAM を書く (世代が動く = 状態の一部)。
+    constexpr u32 kWrite = 0x9000;
+
+    auto build = [](runner_accounting::Harness& h, Script& sc, ChainBuilder& cb)
+    {
+        cb.place(kA, FakeBlock{8, 0, true, false, 0, false, 0, false, kWrite}, kB, true);
+        cb.place(kB, FakeBlock{6, 0, false, true, kC, false, 0, false, 0}, 0, false, true);
+        cb.place(kC, FakeBlock{4, kEnd, false, false, 0, false, 0, false, 0});
+        (void)h;
+    };
+
+    // (a) 1 呼び出しで 3 本。
+    x68k::M68kState chained{};
+    std::vector<u8> chainedRam;
+    std::vector<std::uint16_t> chainedGen;
+    {
+        runner_accounting::Harness h;
+        Script sc;
+        ChainBuilder cb(h, sc);
+        HookGuard guard(sc);
+        build(h, sc, cb);
+
+        const x68k::NativeResult r = h.runAt(kA, 0xFFFFFFFFu);
+        REQUIRE(r.exit == x68k::NativeExit::kRan);
+        REQUIRE(sc.calls.size() == 3);
+        chained = h.cpu().state();
+        chainedRam = h.ram;
+        chainedGen = h.gen;
+    }
+
+    // (b) budget 0 で 1 本ずつ 3 回。**同じ台本・同じ順序。**
+    x68k::M68kState stepped{};
+    std::vector<u8> steppedRam;
+    std::vector<std::uint16_t> steppedGen;
+    {
+        runner_accounting::Harness h;
+        Script sc;
+        ChainBuilder cb(h, sc);
+        HookGuard guard(sc);
+        build(h, sc, cb);
+
+        u32 pc = kA;
+        for (int i = 0; i < 3; ++i)
+        {
+            const x68k::NativeResult r = h.runAt(pc, 0);
+            REQUIRE(r.exit == x68k::NativeExit::kRan);
+            // budget 0 なので必ず 1 本で戻る。
+            REQUIRE(static_cast<int>(sc.calls.size()) == i + 1);
+            pc = h.cpu().state().pc - 4;
+        }
+        stepped = h.cpu().state();
+        steppedRam = h.ram;
+        steppedGen = h.gen;
+    }
+
+    // **ビット単位で比べる。** M68kState は POD なので memcmp でよい。
+    CHECK(std::memcmp(&chained, &stepped, sizeof(x68k::M68kState)) == 0);
+    CHECK(chainedRam == steppedRam);
+    CHECK(chainedGen == steppedGen);
+}
+
+// --- D3: 割り込みの受理は 1 ブロック以上遅れない ------------------------------
+
+TEST_CASE("direct chaining: 割り込みが立った直後の hop で必ず切れる")
+{
+    // **変異: hop の mustDeferToStep() を消す** → チェーンが 3 本走り切る。
+    //
+    // これは実行後の状態を比べても見えない。割り込みは遅れて受理される
+    // だけで、M68kState もメモリも「正しい」。**何本目で切れたか**を
+    // 直接問うしかない。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+    constexpr u32 kC = 0x3000;
+    constexpr u32 kEnd = 0x4000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    cb.place(kA, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kB, true);
+    cb.place(kB, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kC, true);
+    cb.place(kC, FakeBlock{8, kEnd, false, false, 0, false, 0, false, 0});
+    cb.place(kEnd, FakeBlock{8, 0x5000, false, false, 0, false, 0, false, 0});
+
+    // **1 本目の実行中に割り込みが立つ。**
+    sc.raiseIrqBefore = 1;
+
+    const x68k::NativeResult r = h.runAt(kA, 0xFFFFFFFFu);
+
+    CHECK(r.exit == x68k::NativeExit::kRan);
+    // **1 本走ったところで切れること。** 遅れの上限が 1 ブロック。
+    CHECK(sc.calls.size() == 1);
+    CHECK(r.cycles == 8);
+    CHECK(h.stats().chainStopDefer == 1);
+    // 受理はまだ。Machine が step() を回して受理する。
+    CHECK(h.cpu().pendingInterruptLevel() == 6);
+}
+
+TEST_CASE("direct chaining: 入口で割り込みが立っていれば 1 本も走らない")
+{
+    // 現行の入口検査 (設計 §5.4) が生きていること。**チェーンにしたときに
+    // 入口の検査をループの中へ畳んで消す**変異を捕まえる。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    cb.place(kA, FakeBlock{8, 0x2000, false, false, 0, false, 0, false, 0});
+    h.cpu().requestInterrupt(6, 0x40);
+
+    const x68k::NativeResult r = h.runAt(kA, 0xFFFFFFFFu);
+
+    CHECK(r.exit == x68k::NativeExit::kDeferToStep);
+    CHECK(r.cycles == 0);
+    CHECK(sc.calls.empty());
+    CHECK(h.stats().deferInterrupt == 1);
+}
