+// --- D5: チェーン中の自己無効化 (pull 型を守っている証拠) ---------------------
+
+TEST_CASE("direct chaining: 先行ブロックが次のページを書いたら次の hop で切れる")
+{
+    // **これがチェーンの一番危ないところ。**
+    //
+    // 「直前の hop が次の hop の的を無効化する」がチェーンの内側で起きる。
+    // Tier C の書き形は生成コードの中でゲスト RAM を書き、世代を touch する
+    // (G14/G16)。その書き込み先が**次に飛ぶブロックのページ**だったら、
+    // 次の hop はもう古い。
+    //
+    // **変異: 世代を hop の外へ持ち上げる** (run() の入口で 1 回だけ読む)
+    // → 2 本目が走ってしまう。**書き換えられた番地の古いコードを実行する** —
+    // pull 型が原理的に排除していたはずの状態がチェーンの中に生まれる。
+    //
+    // 実行後の状態を比べる形では見えない (偽のブロックは何を実行しても
+    // 「正しい」ので)。**走った本数だけが証拠。**
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    // A は走るついでに **B のページ**を書く。
+    cb.place(kA, FakeBlock{8, 0, true, false, 0, false, 0, false, kB + 0x10}, kB, true);
+    cb.place(kB, FakeBlock{8, 0x3000, false, false, 0, false, 0, false, 0});
+
+    // 置いた時点では B の鍵は当たる状態。**A が走る前は繋がっている。**
+    REQUIRE(h.slots[cb.foldedIndexOf(kB)].pageGen == h.cpu().codeGenMap().generation(kB));
+
+    const x68k::NativeResult r = h.runAt(kA, 0xFFFFFFFFu);
+
+    CHECK(r.exit == x68k::NativeExit::kRan);
+    // **A だけが走ること。** B は A 自身の書き込みで古くなった。
+    CHECK(sc.calls.size() == 1);
+    CHECK(r.cycles == 8);
+    CHECK(h.stats().chainStopMiss == 1);
+    // 世代が実際に動いていること (テストの前提が成り立っている確認)。
+    CHECK(h.cpu().codeGenMap().generation(kB) != h.slots[cb.foldedIndexOf(kB)].pageGen);
+}
+
+TEST_CASE("direct chaining: 同じページを書いても他のページのブロックは繋がる")
+{
+    // 上の裏。**世代を毎 hop 読むことが「常に切る」に化けていないこと。**
+    // 切りすぎる変異 (毎 hop 必ず miss にする) はチェーンを 1 本に潰すが、
+    // 正しさは 1 ビットも壊れないので D2 も D5 も通ってしまう。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+    // B とは別のページ (1KB ページなので 0x2000 と 0x8000 は別)。
+    constexpr u32 kWrite = 0x8000;
+
+    runner_accounting::Harness h;
+    Script sc;
+    ChainBuilder cb(h, sc);
+    HookGuard guard(sc);
+
+    cb.place(kA, FakeBlock{8, 0, true, false, 0, false, 0, false, kWrite}, kB, true);
+    cb.place(kB, FakeBlock{8, 0x3000, false, false, 0, false, 0, false, 0});
+
+    const x68k::NativeResult r = h.runAt(kA, 0xFFFFFFFFu);
+
+    CHECK(r.exit == x68k::NativeExit::kRan);
+    CHECK(sc.calls.size() == 2);
+    CHECK(r.cycles == 16);
+}
