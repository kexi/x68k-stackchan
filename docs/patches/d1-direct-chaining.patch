+// --- D4: budget ---------------------------------------------------------------
+
+TEST_CASE("direct chaining: budget を超えたら次のブロックを走らせない")
+{
+    // **変異: budget 検査を消す** → 4 本全部走る。
+    //
+    // これも実行後の状態は正しいまま。デバイスの期限を跨ぐだけなので、
+    // **走った本数を数える**以外に問い方がない。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+    constexpr u32 kC = 0x3000;
+    constexpr u32 kD = 0x4000;
+    constexpr u32 kEnd = 0x5000;
+
+    // 1 本 8 サイクル。budget = 20 なら 8 + 8 = 16 < 20 で 3 本目へ進み、
+    // 24 >= 20 でそこで切れる。**「超えたら止める」ではなく
+    // 「達したら止める」** (期限超過の上限を 1 ブロックに保つため)。
+    auto runWithBudget = [](std::uint32_t budget, std::size_t& calls, std::uint32_t& cycles,
+                            std::uint64_t& stopBudget)
+    {
+        runner_accounting::Harness h;
+        Script sc;
+        ChainBuilder cb(h, sc);
+        HookGuard guard(sc);
+
+        cb.place(kA, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kB, true);
+        cb.place(kB, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kC, true);
+        cb.place(kC, FakeBlock{8, 0, true, false, 0, false, 0, false, 0}, kD, true);
+        cb.place(kD, FakeBlock{8, kEnd, false, false, 0, false, 0, false, 0});
+
+        const x68k::NativeResult r = h.runAt(kA, budget);
+        calls = sc.calls.size();
+        cycles = r.cycles;
+        stopBudget = h.stats().chainStopBudget;
+    };
+
+    SUBCASE("budget 0 でも 1 本は走る")
+    {
+        // **1 本目は必ず走る。** budget 0 を「1 命令も実行しない」と読むと、
+        // 期限に達した瞬間に JIT が完全に止まる (Machine は kDeferToStep を
+        // 見て step() へ落ちるので正しさは保たれるが、被覆が黙って消える)。
+        std::size_t calls = 0;
+        std::uint32_t cycles = 0;
+        std::uint64_t stopBudget = 0;
+        runWithBudget(0, calls, cycles, stopBudget);
+        CHECK(calls == 1);
+        CHECK(cycles == 8);
+        CHECK(stopBudget == 1);
+    }
+
+    SUBCASE("budget 20 なら 8+8+8 で 3 本目に達して止まる")
+    {
+        std::size_t calls = 0;
+        std::uint32_t cycles = 0;
+        std::uint64_t stopBudget = 0;
+        runWithBudget(20, calls, cycles, stopBudget);
+        CHECK(calls == 3);
+        CHECK(cycles == 24);
+        CHECK(stopBudget == 1);
+    }
+
+    SUBCASE("budget 16 ならちょうど使い切った 2 本目で止まる")
+    {
+        // **境界。** > で切る変異はここで落ちる (3 本走ってしまう)。
+        std::size_t calls = 0;
+        std::uint32_t cycles = 0;
+        std::uint64_t stopBudget = 0;
+        runWithBudget(16, calls, cycles, stopBudget);
+        CHECK(calls == 2);
+        CHECK(cycles == 16);
+        CHECK(stopBudget == 1);
+    }
+}
