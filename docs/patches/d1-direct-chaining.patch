+    // 飛び先でチェーンが伸びること**を問う。
+    //
+    // 変異: 次の entryPc を slot->branchTarget から採る (動的分岐スロットの
+    // branchTarget は設計上つねに 0 なので、0 番地のブロックを探しにいく)。
+    using namespace runner_chain;
+
+    constexpr u32 kA = 0x1000;
+    constexpr u32 kB = 0x2000;
+
+    runner_accounting::Harness h;
